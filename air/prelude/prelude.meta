name: "prelude"
type: "meta"
about: "Built-in functions and operators available in every AiR environment"

arithmetic: {
    add subtract multiply divide modulus exponent floor_divide
}

aliases: {
    plus: add
    minus: subtract
    star: multiply
    slash: divide
    caret: exponent
    double_slash: floor_divide
}

variadic: {
    adder:       "sum of any number of args"
    subtracter:  "fold subtraction over args"
    multiplier:  "fold multiplication over args"
    divider:     "fold division over args"
}

operators: {
    "+": plus, "-": minus, "*": star, "/": slash
    "%": modulus, "^": caret, "//": double_slash
}

builtins: "Python builtins exposed via build_builtin_lookup()"

implementation: "prelude.py"
