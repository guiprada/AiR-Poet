name: "prelude"
type: "meta"
about: "Thin shim that assembles the AiR runtime environment.
        Arithmetic, comparison, and type-predicate functions live in intrinsics.
        Prelude re-exports them and bridges Python builtins via build_builtin_lookup()."

role: "assembler — not the source of truth for functions"

exports: {
    from_intrinsics: "arithmetic  comparison  type_predicates  OPERATOR_DICT  OPERATOR_LIST"
    own:             "build_builtin_lookup()"
}

builtins: "Python builtins exposed via build_builtin_lookup() (callable builtins only)"

implementation: "air/prelude/prelude.py"
intrinsics: "air/intrinsics/intrinsics.meta"
